# Local development connection. Docker Compose builds its internal DATABASE_URL for the app container.
DATABASE_URL=postgres://docker:replace-this-password@127.0.0.1:5433/db
DB_NAME=db
DB_USERNAME=docker
DB_PASSWORD=replace-this-password
DB_EXTERNAL_PORT=5433
APP_HTTP_PORT=8080
SESSION_SECRET=replace-this-session-secret
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-this-password
PGADMIN_PORT=5050
